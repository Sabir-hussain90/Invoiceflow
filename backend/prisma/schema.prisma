// =====================================================
// InvoiceFlow Pakistan — Complete Prisma Schema
// Prisma 7 + Neon PostgreSQL
// Stores EVERYTHING: auth, shops, products, sales,
// purchases, expenses, reports, notifications, emails,
// audit logs, sessions, and more.
// =====================================================

generator client {
  provider = "prisma-client"
  output   = "../src/prisma/generated"
}

datasource db {
  provider = "postgresql"
}

// =====================================================
// ENUMS
// =====================================================

enum UserRole {
  OWNER
  CASHIER
  STOCK_MANAGER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum PaymentMethod {
  CASH
  JAZZCASH
  EASYPAISA
  BANK_TRANSFER
  DIGITAL_WALLET
  CARD
  CREDIT
  SPLIT
  OTHER
}

enum PaymentStatus {
  PAID
  PARTIALLY_PAID
  UNPAID
  REFUNDED
  PARTIALLY_REFUNDED
}

enum SaleStatus {
  COMPLETED
  RETURNED
  PARTIALLY_RETURNED
  CANCELLED
  DRAFT
}

enum PurchaseStatus {
  RECEIVED
  PENDING
  PARTIALLY_RETURNED
  RETURNED
  CANCELLED
}

enum StockMovementType {
  OPENING_STOCK
  PURCHASE
  SALE
  RETURN_IN
  RETURN_OUT
  DAMAGE
  EXPIRY
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
}

enum ExpenseCategory {
  ELECTRICITY
  RENT
  WAGES
  TRANSPORT
  PACKAGING
  REPAIRS
  INTERNET
  WATER
  GAS
  OFFICE
  MARKETING
  OTHER
}

enum NotificationType {
  LOW_STOCK
  OUT_OF_STOCK
  PAYMENT_DUE
  NEW_SALE
  NEW_PURCHASE
  NEW_CUSTOMER
  RETURN_REQUEST
  PASSWORD_CHANGED
  LOGIN_NEW_DEVICE
  SYSTEM
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

enum EmailType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  WELCOME
  INVOICE
  LOW_STOCK_ALERT
  DAILY_REPORT
  PAYMENT_REMINDER
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
  BOUNCED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  LOGIN_FAILED
  PASSWORD_CHANGE
  PASSWORD_RESET
  EMAIL_VERIFY
  ROLE_CHANGE
  SALE_CREATE
  SALE_CANCEL
  SALE_RETURN
  STOCK_ADJUST
  SETTINGS_UPDATE
}

// =====================================================
// AUTH — Users, Sessions, Tokens, Password Reset
// =====================================================

model User {
  id                  String     @id @default(cuid())
  email               String     @unique
  passwordHash        String
  fullName            String
  phone               String?
  role                UserRole   @default(CASHIER)
  status              UserStatus @default(PENDING_VERIFICATION)
  emailVerified       Boolean    @default(false)
  emailVerifiedAt     DateTime?
  avatarUrl           String?
  lastLoginAt         DateTime?
  lastLoginIp         String?
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  twoFactorEnabled    Boolean    @default(false)
  twoFactorSecret     String?

  shopId              String?
  shop                Shop?      @relation(fields: [shopId], references: [id], onDelete: SetNull)

  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  deletedAt           DateTime?

  sessions            Session[]
  refreshTokens       RefreshToken[]
  passwordResets      PasswordReset[]
  emailVerifications  EmailVerification[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  sales               Sale[]
  purchases           Purchase[]
  expenses            Expense[]
  stockMovements      StockMovement[]
  returns             Return[]
  payments            Payment[]
  emailLogs           EmailLog[]

  @@index([email])
  @@index([shopId])
  @@index([role])
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  token        String    @unique
  ipAddress    String?
  userAgent    String?
  deviceName   String?
  isActive     Boolean   @default(true)
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  lastActiveAt DateTime  @default(now())
  revokedAt    DateTime?

  @@index([userId])
  @@index([token])
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  token      String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([token])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  ipAddress String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([token])
}

model EmailVerification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  token      String    @unique
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([token])
}

// =====================================================
// SHOP + INVOICE COUNTER
// =====================================================

model Shop {
  id                 String   @id @default(cuid())
  name               String
  legalName          String?
  ntnNumber          String?
  strnNumber         String?
  phone              String?
  email              String?
  address            String?
  city               String?
  province           String?
  country            String   @default("Pakistan")
  postalCode         String?
  logoUrl            String?
  currency           String   @default("PKR")
  timezone           String   @default("Asia/Karachi")
  invoicePrefix      String   @default("INV")
  invoiceFooter      String?
  taxEnabled         Boolean  @default(false)
  taxPercentage      Decimal  @default(0) @db.Decimal(5, 2)
  lowStockThreshold  Int      @default(5)
  allowNegativeStock Boolean  @default(false)
  isActive           Boolean  @default(true)

  // ⬇ NEW FIELDS — JazzCash & EasyPaisa account numbers
  jazzcashNumber     String?
  easypaisaNumber    String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  deletedAt          DateTime?

  users            User[]
  products         Product[]
  categories       Category[]
  sales            Sale[]
  purchases        Purchase[]
  expenses         Expense[]
  customers        Customer[]
  suppliers        Supplier[]
  stockMovements   StockMovement[]
  returns          Return[]
  payments         Payment[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  invoices         Invoice[]
  invoiceCounters  InvoiceCounter[]

  @@index([name])
}

model InvoiceCounter {
  id         String   @id @default(cuid())
  shopId     String
  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  year       Int
  prefix     String   @default("INV")
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([shopId, year, prefix])
}

// =====================================================
// CATEGORIES + PRODUCTS
// =====================================================

model Category {
  id          String    @id @default(cuid())
  shopId      String
  shop        Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  name        String
  description String?
  isActive    Boolean   @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  products    Product[]

  @@unique([shopId, name])
  @@index([shopId])
}

model Product {
  id             String    @id @default(cuid())
  shopId         String
  shop           Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  categoryId     String?
  category       Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  name           String
  description    String?
  sku            String?
  barcode        String?
  unit           String    @default("piece")

  costPrice      Decimal   @db.Decimal(12, 2)
  sellingPrice   Decimal   @db.Decimal(12, 2)
  wholesalePrice Decimal?  @db.Decimal(12, 2)

  stockQty       Decimal   @default(0) @db.Decimal(12, 3)
  minStockLevel  Decimal   @default(0) @db.Decimal(12, 3)
  maxStockLevel  Decimal?  @db.Decimal(12, 3)

  hasExpiry      Boolean   @default(false)
  expiryDate     DateTime?
  batchNumber    String?

  imageUrl       String?
  isActive       Boolean   @default(true)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  saleItems      SaleItem[]
  purchaseItems  PurchaseItem[]
  stockMovements StockMovement[]
  returnItems    ReturnItem[]

  @@unique([shopId, sku])
  @@index([shopId])
  @@index([categoryId])
  @@index([name])
  @@index([barcode])
}

// =====================================================
// CUSTOMERS + SUPPLIERS
// =====================================================

model Customer {
  id             String    @id @default(cuid())
  shopId         String
  shop           Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  name           String
  phone          String?
  email          String?
  address        String?
  city           String?
  cnic           String?
  notes          String?

  openingBalance Decimal   @default(0) @db.Decimal(12, 2)
  creditLimit    Decimal   @default(0) @db.Decimal(12, 2)
  totalOwed      Decimal   @default(0) @db.Decimal(12, 2)
  totalPaid      Decimal   @default(0) @db.Decimal(12, 2)

  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  sales          Sale[]
  payments       Payment[]
  returns        Return[]

  @@index([shopId])
  @@index([phone])
  @@index([name])
}

model Supplier {
  id             String    @id @default(cuid())
  shopId         String
  shop           Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  name           String
  companyName    String?
  phone          String?
  email          String?
  address        String?
  city           String?
  ntnNumber      String?

  openingBalance Decimal   @default(0) @db.Decimal(12, 2)
  totalOwed      Decimal   @default(0) @db.Decimal(12, 2)
  totalPaid      Decimal   @default(0) @db.Decimal(12, 2)

  notes          String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  purchases      Purchase[]

  @@index([shopId])
  @@index([phone])
}

// =====================================================
// SALES + SALE ITEMS + INVOICES
// =====================================================

model Sale {
  id              String        @id @default(cuid())
  shopId          String
  shop            Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)

  invoiceNumber   String
  invoice         Invoice?

  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)

  cashierId       String
  cashier         User          @relation(fields: [cashierId], references: [id])

  status          SaleStatus    @default(COMPLETED)
  paymentStatus   PaymentStatus @default(UNPAID)

  subtotal        Decimal       @db.Decimal(12, 2)
  discountAmount  Decimal       @default(0) @db.Decimal(12, 2)
  discountPercent Decimal       @default(0) @db.Decimal(5, 2)
  taxAmount       Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal       @db.Decimal(12, 2)

  costOfGoodsSold Decimal       @default(0) @db.Decimal(12, 2)
  grossProfit     Decimal       @default(0) @db.Decimal(12, 2)

  amountPaid      Decimal       @default(0) @db.Decimal(12, 2)
  amountDue       Decimal       @default(0) @db.Decimal(12, 2)
  changeGiven     Decimal       @default(0) @db.Decimal(12, 2)

  notes           String?
  saleDate        DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  items           SaleItem[]
  payments        Payment[]
  returns         Return[]

  @@unique([shopId, invoiceNumber])
  @@index([shopId])
  @@index([customerId])
  @@index([cashierId])
  @@index([saleDate])
  @@index([status])
  @@index([paymentStatus])
}

model SaleItem {
  id             String   @id @default(cuid())
  saleId         String
  sale           Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  productId      String
  product        Product  @relation(fields: [productId], references: [id])

  productName    String
  sku            String?

  quantity       Decimal  @db.Decimal(12, 3)
  unit           String
  unitPrice      Decimal  @db.Decimal(12, 2)
  costPrice      Decimal  @db.Decimal(12, 2)
  discountAmount Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal      Decimal  @db.Decimal(12, 2)

  returnQty      Decimal  @default(0) @db.Decimal(12, 3)

  createdAt      DateTime @default(now())

  returnItems    ReturnItem[]

  @@index([saleId])
  @@index([productId])
}

model Invoice {
  id             String    @id @default(cuid())
  saleId         String    @unique
  sale           Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)

  shopId         String
  shop           Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  invoiceNumber  String    @unique
  pdfUrl         String?
  pdfGeneratedAt DateTime?
  printedCount   Int       @default(0)
  lastPrintedAt  DateTime?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([shopId])
}

// =====================================================
// PAYMENTS
// =====================================================

model Payment {
  id           String        @id @default(cuid())
  shopId       String
  shop         Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)

  saleId       String?
  sale         Sale?         @relation(fields: [saleId], references: [id], onDelete: SetNull)

  customerId   String?
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)

  receivedById String?
  receivedBy   User?         @relation(fields: [receivedById], references: [id], onDelete: SetNull)

  amount       Decimal       @db.Decimal(12, 2)
  method       PaymentMethod
  status       PaymentStatus @default(PAID)
  reference    String?
  notes        String?

  paidAt       DateTime      @default(now())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([shopId])
  @@index([saleId])
  @@index([customerId])
  @@index([paidAt])
}

// =====================================================
// PURCHASES
// =====================================================

model Purchase {
  id             String         @id @default(cuid())
  shopId         String
  shop           Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)

  purchaseNumber String
  supplierId     String
  supplier       Supplier       @relation(fields: [supplierId], references: [id])

  purchasedById  String
  purchasedBy    User           @relation(fields: [purchasedById], references: [id])

  status         PurchaseStatus @default(RECEIVED)

  subtotal       Decimal        @db.Decimal(12, 2)
  discountAmount Decimal        @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal        @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal        @db.Decimal(12, 2)

  amountPaid     Decimal        @default(0) @db.Decimal(12, 2)
  amountDue      Decimal        @default(0) @db.Decimal(12, 2)

  paymentMethod  PaymentMethod  @default(CASH)
  notes          String?
  purchaseDate   DateTime       @default(now())
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  items          PurchaseItem[]

  @@unique([shopId, purchaseNumber])
  @@index([shopId])
  @@index([supplierId])
  @@index([purchaseDate])
}

model PurchaseItem {
  id          String   @id @default(cuid())
  purchaseId  String
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  productId   String
  product     Product  @relation(fields: [productId], references: [id])

  productName String
  quantity    Decimal  @db.Decimal(12, 3)
  unit        String
  unitCost    Decimal  @db.Decimal(12, 2)
  lineTotal   Decimal  @db.Decimal(12, 2)
  returnQty   Decimal  @default(0) @db.Decimal(12, 3)

  createdAt   DateTime @default(now())

  @@index([purchaseId])
  @@index([productId])
}

// =====================================================
// EXPENSES
// =====================================================

model Expense {
  id            String          @id @default(cuid())
  shopId        String
  shop          Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)

  category      ExpenseCategory
  title         String
  description   String?
  amount        Decimal         @db.Decimal(12, 2)
  paymentMethod PaymentMethod   @default(CASH)

  expenseDate   DateTime        @default(now())
  createdById   String?
  createdBy     User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)

  receiptUrl    String?
  notes         String?

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?

  @@index([shopId])
  @@index([expenseDate])
  @@index([category])
}

// =====================================================
// STOCK MOVEMENTS
// =====================================================

model StockMovement {
  id            String            @id @default(cuid())
  shopId        String
  shop          Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)

  productId     String
  product       Product           @relation(fields: [productId], references: [id])

  type          StockMovementType
  quantity      Decimal           @db.Decimal(12, 3)
  balanceAfter  Decimal           @db.Decimal(12, 3)

  referenceType String?
  referenceId   String?

  reason        String?
  unitCost      Decimal?          @db.Decimal(12, 2)

  createdById   String?
  createdBy     User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt     DateTime          @default(now())

  @@index([shopId])
  @@index([productId])
  @@index([type])
  @@index([createdAt])
  @@index([referenceType, referenceId])
}

// =====================================================
// RETURNS
// =====================================================

model Return {
  id            String        @id @default(cuid())
  shopId        String
  shop          Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)

  returnNumber  String
  saleId        String
  sale          Sale          @relation(fields: [saleId], references: [id])

  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)

  processedById String
  processedBy   User          @relation(fields: [processedById], references: [id])

  reason        String
  notes         String?

  refundAmount  Decimal       @db.Decimal(12, 2)
  refundMethod  PaymentMethod @default(CASH)
  restockItems  Boolean       @default(true)

  returnDate    DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items         ReturnItem[]

  @@unique([shopId, returnNumber])
  @@index([shopId])
  @@index([saleId])
  @@index([returnDate])
}

model ReturnItem {
  id         String   @id @default(cuid())
  returnId   String
  return     Return   @relation(fields: [returnId], references: [id], onDelete: Cascade)

  saleItemId String
  saleItem   SaleItem @relation(fields: [saleItemId], references: [id])

  productId  String
  product    Product  @relation(fields: [productId], references: [id])

  quantity   Decimal  @db.Decimal(12, 3)
  unitPrice  Decimal  @db.Decimal(12, 2)
  lineTotal  Decimal  @db.Decimal(12, 2)
  restocked  Boolean  @default(true)

  createdAt  DateTime @default(now())

  @@index([returnId])
}

// =====================================================
// NOTIFICATIONS
// =====================================================

model Notification {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  shopId    String?
  shop      Shop?               @relation(fields: [shopId], references: [id], onDelete: Cascade)

  type      NotificationType
  channel   NotificationChannel @default(IN_APP)

  title     String
  message   String
  actionUrl String?
  metadata  Json?

  isRead    Boolean             @default(false)
  readAt    DateTime?
  sentAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId, isRead])
  @@index([shopId])
  @@index([createdAt])
}

// =====================================================
// EMAIL LOGS
// =====================================================

model EmailLog {
  id          String      @id @default(cuid())
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  type        EmailType
  status      EmailStatus @default(PENDING)

  toEmail     String
  fromEmail   String
  subject     String
  bodyPreview String?
  messageId   String?
  error       String?

  sentAt      DateTime?
  createdAt   DateTime    @default(now())

  @@index([toEmail])
  @@index([type])
  @@index([status])
}

// =====================================================
// AUDIT LOGS
// =====================================================

model AuditLog {
  id          String      @id @default(cuid())
  shopId      String?
  shop        Shop?       @relation(fields: [shopId], references: [id], onDelete: SetNull)

  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  action      AuditAction
  entity      String?
  entityId    String?
  description String?
  before      Json?
  after       Json?

  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  @@index([shopId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}